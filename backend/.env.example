# CityGraph Backend Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit the actual .env file to version control.

# Application Environment: 'development' | 'production'
ENVIRONMENT=development

# Cryptographically strong JWT Secret Key (required in production, min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_chars_long

# JWT Token Expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL (SQLite or PostgreSQL)
# Example PostgreSQL: postgresql://user:password@host:5432/citygraph
DATABASE_URL=sqlite:///./citygraph.db

# Comma-separated allowed frontend origins for CORS (no trailing slashes, NO WILDCARD in production)
# Example: https://citygraph.vercel.app,https://citygraph-git-main.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173

# Server Bind Port (set automatically by hosting platforms such as Render)
PORT=8000

# Swagger / OpenAPI documentation enabled: 'true' | 'false'
ENABLE_DOCS=true

# Initial Admin Seeding in production (disabled by default)
# Set to 'true' and define INITIAL_ADMIN_PASSWORD if you wish to seed an admin on first launch
SEED_DEFAULT_USER=false
INITIAL_ADMIN_EMAIL=admin@citygraph.org
INITIAL_ADMIN_PASSWORD=

# Adapter / feed strategy
USE_LIVE_FEEDS=false
OPEN_METEO_API_KEY=
TOMTOM_API_KEY=
TELEGRAM_BOT_TOKEN=
COPERNICUS_USER=
COPERNICUS_PASSWORD=
